# Root convenience values. Copy app-specific examples into their local env files.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ENV=development
PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:<password>@<host>:5432/postgres
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ADMIN_RATE_LIMIT_PER_MINUTE=120
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=5
DB_DISABLE_PREPARED_STATEMENTS=false
