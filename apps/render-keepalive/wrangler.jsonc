{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tunhuabinhnham-render-keepalive",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-10",
  // Cron-only Worker: no public URL, no routes, no bindings.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "TARGET_URL": "https://tunhuabinhnham-api.onrender.com/health/live",
    "TIMEOUT_MS": "120000"
  },
  // Optional alert: Cloudflare Secret ALERT_WEBHOOK_URL (Discord/Slack-style JSON webhook), never a var.
  // Unset = webhook alerts DISABLED; failed pings still fail the invocation (Metrics / Cron Events).
  // Cron Triggers run in UTC. Asia/Ho_Chi_Minh = UTC+7.
  // Interleaved 10-min mode (owner-approved 2026-11-15): this Worker pings :02/:12/:22/:32/:42/:52, GitHub Actions
  // (.github/workflows/render-keepalive.yml on the default branch) pings :07/:17/.../:57 from non-Cloudflare IPs,
  // so a ping every 5 min while both run. 06:02..00:52 VN here, last ping 01:00 VN.
  // Rollback to the previous 30-minute mode: first entry "22,52 0-17 * * *".
  "triggers": {
    "crons": ["2,12,22,32,42,52 23,0-17 * * *", "0 18 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
