{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tunhuabinhnham-render-keepalive",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-10",
  // Cron-only Worker: no public URL, no routes, no bindings.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "TARGET_URL": "https://tunhuabinhnham-api.onrender.com/health/live",
    "TIMEOUT_MS": "120000"
  },
  // Optional alert: Cloudflare Secret ALERT_WEBHOOK_URL (Discord/Slack-style JSON webhook), never a var.
  // Unset = webhook alerts DISABLED; failed pings still fail the invocation (Metrics / Cron Events).
  // Cron Triggers run in UTC. Asia/Ho_Chi_Minh = UTC+7.
  // 15-minute mode (ACTIVE, owner-approved 2026-11-13 after repeated Render 429 challenges in 10-min mode): 07:00..00:45 VN every 15 min, last ping 01:00 VN.
  // Rollback to 30-minute mode: replace the first entry with "0,30 0-17 * * *".
  "triggers": {
    "crons": ["*/15 0-17 * * *", "0 18 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
