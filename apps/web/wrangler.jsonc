{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tunhuabinhnham-web",
  "main": "worker.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Workers Cache: worker.ts marks only anonymous public pages cacheable (src/lib/edge-cache.ts).
  "cache": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tunhuabinhnham-web"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
